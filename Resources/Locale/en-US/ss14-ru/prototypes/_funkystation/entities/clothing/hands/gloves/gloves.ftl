ent-FuClothingHandsGlovesConducting = { ent-FuClothingHandsGlovesInsuls }
    .suffix = Conducting
    .desc = { ent-FuClothingHandsGlovesInsuls.desc }
ent-FuClothingHandsGlovesColorYellow = yellow gloves
    .desc = Regular yellow gloves that do not keep you from frying.
ent-FuClothingHandsGlovesChiefEngineerInsuls = chief engineer's arc gloves
    .desc = High-quality, heavy-duty insulated arc gloves. These'll keep you safe from just about any voltage.
ent-FuClothingHandsGlovesArcGloves = arc gloves
    .desc = Industrial-grade arc gloves designed to keep you safe from any high voltages you may encounter. Or, at least, make your funeral open casket.
